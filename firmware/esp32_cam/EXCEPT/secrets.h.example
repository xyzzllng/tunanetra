#pragma once

// Salin file ini menjadi secrets.h, lalu isi dengan konfigurasi lokal Anda.
// Jangan commit secrets.h ke Git (.gitignore sudah menutupinya).

#define WIFI_SSID       "NAMA_WIFI_ANDA"
#define WIFI_PASSWORD   "PASSWORD_WIFI_ANDA"

// Nama host mDNS (http://esp32cam.local). Windows/macOS/Linux modern mengenalinya,
// tetapi IP tetap (reservasi DHCP di router) lebih andal untuk ESP32CAM_URL di backend.
#define CAM_HOSTNAME    "esp32cam"

// Isi bila ESP32CAM_TOKEN di .env backend juga diisi. Kosongkan bila tidak.
// Sangat disarankan: tanpa token siapa pun di jaringan bisa mengambil gambar kamera.
#define CAM_TOKEN       ""
